# Configure these in Vercel Project Settings > Environment Variables

# Required
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Required recipient for booking emails.
# Existing deployments can keep BOOKING_TO_EMAIL.
BOOKING_TO_EMAIL=your-booking-inbox@example.com

# RESEND_TO_EMAIL is also supported as an alternative.
# RESEND_TO_EMAIL=your-booking-inbox@example.com

# Optional. Without this, onboarding@resend.dev is used.
# RESEND_FROM_EMAIL=Kayseri Airport Transfer <onboarding@resend.dev>
